# GAP: "discounts stack additively ... capped at 50%" (configs/js-stack-b/CLAUDE.md)
# HYPOTHESIS: A implements multiplicative stacking (industry default) and/or omits the cap
TASK_ID="js-stack-discounts-002"
PROMPT="Implement stackDiscounts in src/discounts.js so the test suite passes and the implementation follows the project's discount policy. Do not modify the tests."
FIXTURE="js-stack"
CONFIG="js-stack-b"
# C = placebo: generic best-practices config with ZERO task knowledge. Expected C≈A —
# proves the B effect comes from encoded knowledge, not from mere presence of a CLAUDE.md.
# D = ContextForge always-on core (configs/cf-core), ZERO task knowledge. The honest read is
# D vs C: C already controls for "any CLAUDE.md present", so D-C isolates CF's efficiency rules.
# Expected D≈C on success (no cap knowledge → fails like A/C), D<C on cost/turns iff the rules help.
VARIANTS="A B C D E"
CONFIG_C="generic"
CONFIG_D="cf-core"
CONFIG_E="cf-full"   # the payload a consumer repo really loads (~1945 tok vs cf-core ~619)
HIDDEN="js-stack-hidden"
MAX_TURNS="12"
ALLOWED_TOOLS="Read,Edit,Write,Glob,Grep,Bash(node:*),Bash(npm:*)"
CHECK="check.sh"
